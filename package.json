{
	"name": "@abeedoo/bigdesign-svelte",
	"version": "0.2.0",
	"description": "Svelte 5 port of BigCommerce's BigDesign component library",
	"type": "module",
	"scripts": {
		"dev": "mkdir -p .logs && vite dev 2>&1 | tee .logs/vite.log",
		"build": "vite build",
		"build:all": "vite build && npm run package",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "npm run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./theme": "./dist/theme/tokens.css"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/package": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"publint": "^0.3.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"typescript": "^5.0.0",
		"vite": "^6.0.0"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/abeedoolabs/bigdesign-svelte.git"
	},
	"keywords": [
		"svelte",
		"bigcommerce",
		"bigdesign",
		"components",
		"ui"
	],
	"license": "MIT",
	"dependencies": {
		"@sveltejs/adapter-static": "^3.0.10"
	}
}
